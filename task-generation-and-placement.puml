@startuml
title Генерация кадра и постановка (диспетчер постановки)
|Календарь событий|
start
:Событие GENERATE(t, источник k);
|Источник|
:Создать Request(sourceId = k, arrivalTime = t);
:Запланировать следующий GENERATE\nв момент t + Exp(λ) (ИЗ1);
|Статистика|
:onGenerated: generated++;
|Диспетчер постановки|
:accept(request, t);
:Найти свободный прибор\nс наименьшим номером (Д2П1);
if (Свободный прибор найден?) then (да, HappyFlow)
  |Прибор|
  :start(request, t): ожидание = 0;
  |Календарь событий|
  :Запланировать DEVICE_FREE\nв момент t + τ, τ ~ U(a, b) (ПЗ2);
  |Статистика|
  :onServiceStarted;
  stop
else (нет, все приборы заняты)
endif
|Буфер|
if (Есть свободная позиция?) then (да)
  :put: первая свободная позиция\nс начала, без сдвига (Д1ОЗ3);
else (нет, переполнение)
  :removeOldest: заявка с min arrivalTime (Д1ОО3);
  |Статистика|
  :onEvicted: evicted++ (отказ);
  |Буфер|
  :putAt: новая заявка на место вытесненной;
endif
stop
@enduml
